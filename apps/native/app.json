{
	"expo": {
		"scheme": "legacy-building",
		"userInterfaceStyle": "light",
		"orientation": "default",
		"web": {
			"bundler": "metro"
		},
		"name": "Legacy Building",
		"slug": "legacy-building",
		"version": "1.0.4",
		"icon": "./assets/images/icon.png",
		"plugins": [
			"expo-font",
			"expo-apple-authentication",
			[
				"expo-image-picker",
				{
					"photosPermission": "Legacy Building uses your photos so you can add pictures and videos to your journal.",
					"cameraPermission": "Legacy Building uses your camera so you can take photos and record video journal entries.",
					"microphonePermission": "Legacy Building uses your microphone to record audio for your video journal entries."
				}
			],
			"@react-native-community/datetimepicker",
			[
				"expo-audio",
				{
					"microphonePermission": "Legacy Building uses your microphone to record journal entries.",
					"enableBackgroundPlayback": false
				}
			],
			"expo-router",
			[
				"expo-notifications",
				{
					"color": "#008080"
				}
			],
			"./plugins/with-google-modular-headers",
			"expo-asset",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 220,
					"resizeMode": "contain",
					"backgroundColor": "#008080"
				}
			],
			"expo-video"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"android": {
			"package": "com.legacybuildingjournals.app",
			"blockedPermissions": [
				"android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
			],
			"adaptiveIcon": {
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			}
		},
		"ios": {
			"bundleIdentifier": "com.legacybuildingjournals.app",
			"deploymentTarget": "17.0",
			"supportsTablet": true,
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false
			}
		},
		"extra": {
			"eas": {
				"projectId": "beb8a12c-54c4-448e-a60f-411bafbeacef"
			}
		},
		"owner": "sliding-scale"
	}
}
